# ---- Language model -------------------------------------------------------
# Default: Ollama running natively on the host (Windows, macOS or Linux).
#   1. install Ollama            https://ollama.com/download
#   2. ollama pull qwen2.5:1.5b
#   3. docker compose up -d --build
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:1.5b
LLM_API_KEY=local

# Alternative: vLLM inside Compose, for Linux hosts with the NVIDIA container
# runtime working. Start with:  docker compose --profile gpu up -d --build
# and set these two lines instead of the Ollama ones above:
#LLM_BASE_URL=http://vllm:8000/v1
#LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_UTIL=0.88

# Ordered fallback chain, tried when the primary fails. LiteLLM model ids, comma separated.
# Examples:
#   FALLBACK_MODELS=ollama/qwen2.5:0.5b
#   FALLBACK_MODELS=gemini/gemini-1.5-flash,openai/gpt-4o-mini
FALLBACK_MODELS=

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Generation -----------------------------------------------------------
TEMPERATURE=0.2
TOP_P=0.9
MAX_TOKENS=640

# Retries per provider before moving to the next entry in the fallback chain.
# Higher rides out transient blips; lower reaches the degraded response sooner.
NUM_RETRIES=1
REQUEST_TIMEOUT=90

# Consecutive failures before a provider is skipped, and for how many seconds.
BREAKER_THRESHOLD=3
BREAKER_COOLDOWN=30

# ---- Traffic and caching --------------------------------------------------
RATE_LIMIT_PER_MIN=30
MAX_CONCURRENT_LLM=8
CACHE_TTL=3600
SEMANTIC_THRESHOLD=0.93

# ---- Retrieval ------------------------------------------------------------
TOP_K=4
MIN_SCORE=0.55
CHUNK_SIZE=900
CHUNK_OVERLAP=150
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Optional energy gate on the router. Leave empty to disable; the router still
# reports the energy score on every reply for drift monitoring.
ENERGY_THRESHOLD=

# Only needed for gated Hugging Face models.
HUGGING_FACE_HUB_TOKEN=
